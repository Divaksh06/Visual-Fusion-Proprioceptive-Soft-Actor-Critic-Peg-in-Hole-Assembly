                                       <geom type="mesh" mesh="inner_finger_coarse" group="0" rgba="0.1 0.1 0.1 1"/>
                                    </body>
                                 </body>

                                 <body name="right_inner_knuckle" pos="-0.0127 0 0.0693075" euler="0 0 3.14159265" gravcomp="1">
