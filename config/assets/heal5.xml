   <sensor>
      <force name="ft_force_sensor" site="ft_sensor_site"/>
      <torque name="ft_torque_sensor" site="ft_sensor_site"/>
   </sensor>

   <actuator>
      <motor name="turret"   joint="joint_1" ctrlrange="-100 100" />
      <motor name="shoulder" joint="joint_2" ctrlrange="-100 100" />
      <motor name="elbow"    joint="joint_3" ctrlrange="-100 100" />
      <motor name="wrist_1"  joint="joint_4" ctrlrange="-50 50" />
      <motor name="wrist_2"  joint="joint_5" ctrlrange="-50 50" />
      <motor name="wrist_3"  joint="joint_6" ctrlrange="-50 50" />
      <motor name="gripper_motor" joint="finger_joint" ctrlrange="-100 100" gear="10"/>
   </actuator>

   <equality>
      <joint joint1="left_inner_knuckle_joint" joint2="finger_joint" polycoef="0 1 0 0 0" />
      <joint joint1="left_inner_finger_joint" joint2="finger_joint" polycoef="0 -1 0 0 0" />
      <joint joint1="right_inner_knuckle_joint" joint2="finger_joint" polycoef="0 -1 0 0 0" />
      <joint joint1="right_inner_finger_joint" joint2="finger_joint" polycoef="0 1 0 0 0" />
      <joint joint1="right_outer_knuckle_joint" joint2="finger_joint" polycoef="0 -1 0 0 0" />
   </equality>

</mujoco>