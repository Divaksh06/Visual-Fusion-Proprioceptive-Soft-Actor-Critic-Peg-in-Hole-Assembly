                                    <geom type="box" size="0.001 0.001 0.001" rgba="1 0 1 0.0"/>
                                    <camera name="realsense_rgb" pos="0 0 0" euler="0 0 0" fovy="60"/>
                                 </body>
                              </body>

                              <body name="robotiq_85_base_link" pos="0 0 0.015" euler="0 0 0" gravcomp="1">
