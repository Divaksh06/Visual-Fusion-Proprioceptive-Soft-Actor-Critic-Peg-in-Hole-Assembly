      <mesh name="link_2" file="link_2.STL" />
      <mesh name="link_3" file="link_3.stl" />
      <mesh name="link_4" file="link_4.STL" />
      <mesh name="link_5" file="link_5.STL" />
      <mesh name="end_effector" file="end_effector.STL" />

      <mesh name="robotiq_85_base_link_fine" file="robotiq/robotiq_85_base_link_fine.STL" />
      <mesh name="robotiq_85_base_link_coarse" file="robotiq/robotiq_85_base_link_coarse.STL" />
      <mesh name="outer_knuckle_fine" file="robotiq/outer_knuckle_fine.STL" />
