      <mesh name="peg_circle" file="peg_circle.stl" />
      <mesh name="hole_circle" file="hole_circle.stl" />
   </asset>

   <contact>
      <exclude body1="base_link" body2="link1" />
      <exclude body1="link1" body2="link2" />
      <exclude body1="link2" body2="link3" />
      <exclude body1="link3" body2="link4" />
      <exclude body1="link4" body2="link5" />
      <exclude body1="link5" body2="end_effector" />
      
      <exclude body1="end_effector" body2="force_torque_sensor" />
      <exclude body1="force_torque_sensor" body2="camera_disk_link" />
      <exclude body1="force_torque_sensor" body2="robotiq_85_base_link" />
      <exclude body1="camera_disk_link" body2="robotiq_85_base_link" />
      
      <exclude body1="robotiq_85_base_link" body2="peg" />
      <!-- <exclude body1="left_inner_finger" body2="peg" />
      <exclude body1="right_inner_finger" body2="peg" /> -->
   </contact>

   <worldbody>
      <geom name="ground_floor" type="plane" size="5 5 .01" pos="0 0 -0.875" rgba="0.8 0.9 0.8 1"/>

      <body name="table" pos="0 0 0">
         <geom name="table_top" type="box" size="1 0.5 0.025" pos="0 0 0.4" rgba="0.4 0.2 0.1 1" />
         <geom name="leg1" type="box" size="0.02 0.02 0.2" pos="0.9 0.45 0.2" rgba="0.1 0.1 0.1 1" />
         <geom name="leg2" type="box" size="0.02 0.02 0.2" pos="-0.9 0.45 0.2" rgba="0.1 0.1 0.1 1" />
         <geom name="leg3" type="box" size="0.02 0.02 0.2" pos="0.9 -0.45 0.2" rgba="0.1 0.1 0.1 1" />
         <geom name="leg4" type="box" size="0.02 0.02 0.2" pos="-0.9 -0.45 0.2" rgba="0.1 0.1 0.1 1" />
      </body>

      <body name="hole_assembly" pos="0.5 0 0.425" euler="-1.571 0 0">
         <geom name="hole_geom_1" type="mesh" mesh="hole_circle" pos="0 0 0.0" rgba="0.2 0.5 0.8 1"/>
      </body>

      <body name="base_link" pos="-0.10 0 0.425" euler="0 0 0">
